--// GAME SERVICES
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()

local ActionsEvent = RS:WaitForChild("Lib"):WaitForChild("EventsPlayer"):WaitForChild("Actions")

local lastMeter = Player:GetAttribute("Meter") or 0
local SHOOT_DELAY = 0.20 -- delay ONLY for ShootBall

--// GET BALL HAND
local function getBallHand()
    Character = Player.Character or Player.CharacterAdded:Wait()

    local right = Character:FindFirstChild("RightHand")
    local left = Character:FindFirstChild("LeftHand")

    if right and right:FindFirstChild("Basketball") then
        return "Right"
    elseif left and left:FindFirstChild("Basketball") then
        return "Left"
    end

    return "Right"
end

--// MAIN AUTO PERFECT LOGIC
Player:GetAttributeChangedSignal("Meter"):Connect(function()
    local newValue = Player:GetAttribute("Meter")

    -- Only run if toggle is ON
    if Rayfield.Flags.AutoPerfect.CurrentValue then
        local threshold = Rayfield.Flags.TimingDelay.CurrentValue

        -- Fire when meter crosses the slider value
        if lastMeter < threshold and newValue >= threshold then

            -- 1. StopMeter instantly
            ActionsEvent:FireServer({
                Action = "StopMeter",
                PumpFake = false
            })

            -- 2. Delay before ShootBall
            task.wait(SHOOT_DELAY)

            -- 3. ShootBall
            local hand = getBallHand()

            ActionsEvent:FireServer({
                ClientTime = 0,
                Action = "ShootBall",
                Hand = hand
            })
        end
    end

    lastMeter = newValue
end)


